{
    "name": "shakil3334413/date-validation",
    "description": "Timezone-aware relative calendar date validation rules for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {"psr-4": {"Shakil\\DateValidation\\": "src/"}},
    "autoload-dev": {"psr-4": {"Shakil\\DateValidation\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["Shakil\\DateValidation\\DateValidationServiceProvider"]}},
    "scripts": {"test": "phpunit"},
    "config": {"sort-packages": true}
}
